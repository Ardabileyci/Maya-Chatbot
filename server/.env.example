# Bu dosyayı .env olarak kopyalayıp kendi değerlerini gir

# Gemini API Key (Google AI Studio'dan alınır)
GEMINI_API_KEY=your_gemini_api_key_here

# Django (production'da mutlaka değiştir)
DJANGO_SECRET_KEY=change_me

# MySQL bağlantısı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Kullanıcı tablosu eşlemesi
DB_USERS_TABLE=users
DB_USERS_ID_COLUMN=id
DB_USERS_NAME_COLUMN=name
DB_USERS_EMAIL_COLUMN=email
DB_USERS_EDUCATIONS_COLUMN=educations

# Eğitim tablosu eşlemesi
DB_EDUCATIONS_TABLE=educations
DB_EDUCATIONS_ID_COLUMN=edu_id
DB_EDUCATIONS_NAME_COLUMN=edu_name
